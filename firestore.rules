rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Direktzugriff für alle Clients gesperrt. Der Browser spricht nie mit
    // Firestore, sondern ausschließlich mit unserer eigenen /api/*-Route.
    // Nur der Server (Admin-SDK mit Service-Account) darf zugreifen -
    // das Admin-SDK umgeht diese Regeln grundsätzlich.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
